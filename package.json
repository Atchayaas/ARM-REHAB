{
  "name": "physical-rehabilitation-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "node backend/server.js",
    "py": "uvicorn main:app --host 0.0.0.0 --port 8000",
    "rehab": "python post_surgery_rehab.py",
    "dev:all": "concurrently \"node backend/server.js\" \"vite --port=3000 --host=0.0.0.0\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
